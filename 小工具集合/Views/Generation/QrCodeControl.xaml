<!-- 文件作用：定义 QR Code 生成工具的内嵌预览、参数和导出界面。 -->
<UserControl x:Class="小工具集合.Views.Generation.QrCodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#969696"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#68217A"/>
        <SolidColorBrush x:Key="InputBrush" Color="#1F1F1F"/>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="QrTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="QR CODE GENERATOR" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="把文本、链接、Wi-Fi 信息或者任何你想塞进去的东西变成二维码。"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <Border Height="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="内容" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="内容模板" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="ContentTemplateComboBox" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="扫码兼容" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="TemplateHintTextBlock"
                                               Foreground="{StaticResource SubtleBrush}"
                                               TextWrapping="Wrap"
                                               MinHeight="32"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="InputTextBox"
                                     Style="{StaticResource QrTextBoxStyle}"
                                     MinHeight="190"
                                     MaxHeight="330"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     TextChanged="InputTextBox_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <Border Height="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="生成参数" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="纠错等级" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="ErrorCorrectionComboBox"
                                              Height="32"
                                              SelectedIndex="1"
                                              SelectionChanged="OptionChanged">
                                        <ComboBoxItem Content="L - 最小"/>
                                        <ComboBoxItem Content="M - 标准"/>
                                        <ComboBoxItem Content="Q - 高"/>
                                        <ComboBoxItem Content="H - 最高"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="像素倍率" Style="{StaticResource LabelStyle}"/>
                                    <Slider x:Name="PixelsPerModuleSlider"
                                            Minimum="4"
                                            Maximum="24"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="12"
                                            ValueChanged="PixelsPerModuleSlider_ValueChanged"/>
                                    <TextBlock x:Name="PixelsPerModuleTextBlock" Foreground="{StaticResource SubtleBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="QuietZoneCheckBox"
                                      Content="保留二维码留白"
                                      Foreground="{StaticResource TextBrush}"
                                      Margin="0,14,0,0"
                                      IsChecked="True"
                                      Checked="OptionChanged"
                                      Unchecked="OptionChanged"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="深色" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="DarkColorTextBox"
                                             Style="{StaticResource QrTextBoxStyle}"
                                             Height="32"
                                             Text="#111111"
                                             LostFocus="ColorTextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="浅色" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="LightColorTextBox"
                                             Style="{StaticResource QrTextBoxStyle}"
                                             Height="32"
                                             Text="#FFFFFF"
                                             LostFocus="ColorTextBox_LostFocus"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="生成" Style="{StaticResource PrimaryButtonStyle}" Click="GenerateButton_Click"/>
                        <Button Content="复制图片" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="CopyButton_Click"/>
                        <Button Content="保存 PNG" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="SaveButton_Click"/>
                        <Button Content="清空" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="ClearButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}" MinHeight="520">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Height="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="预览" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#FDFDFD"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                MinHeight="360"
                                Margin="0,0,0,14">
                            <Grid>
                                <Image x:Name="QrPreviewImage"
                                       Width="330"
                                       Height="330"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                <TextBlock x:Name="EmptyPreviewTextBlock"
                                           Text="输入内容后生成预览"
                                           Foreground="#777777"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="PreviewInfoTextBlock"
                                   Grid.Row="2"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,8">
            <TextBlock x:Name="StatusTextBlock" Foreground="{StaticResource MutedBrush}" Text="准备生成二维码。"/>
        </Border>
    </Grid>
</UserControl>
