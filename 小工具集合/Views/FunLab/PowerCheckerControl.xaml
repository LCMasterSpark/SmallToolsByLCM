<UserControl x:Class="小工具集合.Views.FunLab.PowerCheckerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="18,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="POWER CHECKER" Foreground="#F1F1F1" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="LCMasterSpark 高精度电量存在性判定引擎" Margin="0,4,0,0" Foreground="#969696" FontSize="13"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#007ACC" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="FUN LAB" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MainStatusText"
                       Grid.Row="1"
                       Text="点击按钮开始进行高精度电量检测"
                       Foreground="#4FC1FF"
                       FontSize="28"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="DetailStatusText"
                       Grid.Row="2"
                       Text=""
                       Margin="0,14,0,0"
                       Foreground="#C8C8C8"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <Grid Grid.Row="3" Margin="0,26,0,0" HorizontalAlignment="Center" Width="560">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="AnalysisProgress"
                             Height="14"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#1F1F1F"
                             Foreground="#007ACC"/>
                <TextBlock x:Name="StallText"
                           Grid.Row="1"
                           Text=""
                           Margin="0,8,0,0"
                           Foreground="#F9C74F"
                           FontSize="13"
                           TextAlignment="Center"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <TextBlock Text="不会真的读取电源硬件，但会非常认真地分析。" Foreground="#969696" FontSize="11" VerticalAlignment="Center"/>
                <Button x:Name="StartButton"
                        DockPanel.Dock="Right"
                        Content="开始检测"
                        Width="132"
                        Height="34"
                        Background="#007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="StartButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
