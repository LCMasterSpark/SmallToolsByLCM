<UserControl x:Class="小工具集合.Views.FunLab.MinesweeperControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="扫雷" Foreground="#F1F1F1" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RunStatsText" Text="本次运行：0 胜 / 0 负" Margin="18,0,0,0" Foreground="#969696" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="玩家" Foreground="#969696" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="PlayerNameTextBox"
                             Width="126"
                             Height="30"
                             Margin="0,0,10,0"
                             LostFocus="PlayerNameTextBox_Commit"
                             KeyDown="PlayerNameTextBox_KeyDown"/>
                    <CheckBox x:Name="ArcadeCheckBox" Content="街机模式" Foreground="#F1F1F1" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ArcadeCheckBox_Changed" Unchecked="ArcadeCheckBox_Changed"/>
                    <ComboBox x:Name="DifficultyComboBox" Width="128" Height="30" Margin="0,0,8,0"/>
                    <ComboBox x:Name="BoardSizeComboBox" Width="92" Height="30" Margin="0,0,8,0"/>
                    <Button Content="新局" Width="72" Height="30" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="NewGameButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="14">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <UniformGrid x:Name="BoardGrid" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="状态" Foreground="#F1F1F1" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="选择难度后开始新局。" Margin="0,12,0,0" Foreground="#C8C8C8" TextWrapping="Wrap"/>
                    <Rectangle Height="1" Margin="0,16,0,14" Fill="#3F3F46"/>
                    <TextBlock x:Name="MineText" Text="雷数：-" Foreground="#C8C8C8" Margin="0,0,0,6"/>
                    <TextBlock x:Name="FlagText" Text="标记：-" Foreground="#C8C8C8" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LifeText" Text="生命：-" Foreground="#C8C8C8" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TimerText" Text="用时：00:00" Foreground="#C8C8C8"/>
                    <TextBlock x:Name="BestTimeText" Text="最佳：-" Foreground="#C8C8C8" Margin="0,6,0,0"/>
                    <Rectangle Height="1" Margin="0,16,0,14" Fill="#3F3F46"/>
                    <TextBlock Text="左键揭开，右键标记。普通模式第一步避雷，街机模式有 3 条生命。" Foreground="#969696" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="16,10">
            <TextBlock x:Name="LastResultText" Text="以玩家名保存战绩；无需登录。" Foreground="#969696"/>
        </Border>
    </Grid>
</UserControl>
